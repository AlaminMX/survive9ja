{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/share/:kind(post|diary)/:id",
      "destination": "/api/share-card?kind=:kind&id=:id"
    },
    {
      "source": "/:kind(post|diary)/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|Twitterbot|TelegramBot|Discordbot|Slackbot|LinkedInBot).*"
        }
      ],
      "destination": "/api/share-card?kind=:kind&id=:id"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
